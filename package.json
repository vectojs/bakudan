{
  "name": "bakudan",
  "version": "0.7.2",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vectojs/bakudan.git"
  },
  "bugs": {
    "url": "https://github.com/vectojs/bakudan/issues"
  },
  "homepage": "https://bakudan.vectojs.org",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "format:check": "oxfmt --check \"src/**/*.{js,ts,jsx,tsx,mjs,cjs,json}\"",
    "lint": "oxlint --deny-warnings src",
    "deploy": "bash scripts/deploy-pages.sh dist bakudan main",
    "format": "oxfmt --write \"src/**/*.{js,ts,jsx,tsx,mjs,cjs,json}\"",
    "lint:biome": "biome lint",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "check": "bun run format:check && bun run lint && bun run lint:md",
    "prepare": "lefthook install",
    "export:video": "bun run tools/export-video.ts"
  },
  "dependencies": {
    "@vectojs/core": "1.39.0",
    "@vectojs/danmaku-core": "0.3.2",
    "@vectojs/danmaku-kit": "0.8.0",
    "@vectojs/ui": "2.20.1"
  },
  "peerDependencies": {
    "@vectojs/danmaku-kit": "^0.8.0"
  },
  "peerDependenciesMeta": {
    "@vectojs/danmaku-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@happy-dom/global-registrator": "^20.11.6",
    "@vectojs/devtools": "0.11.2",
    "@vectojs/video-exporter": "0.2.4",
    "carryctx": "0.5.8",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
